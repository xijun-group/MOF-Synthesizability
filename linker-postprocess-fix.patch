+                         Chem.SanitizeFlags.SANITIZE_SYMMRINGS |
+                         Chem.SanitizeFlags.SANITIZE_FINDRADICALS))
+        record.update(n_radical_atoms=sum(bool(a.GetNumRadicalElectrons()) for a in mol.GetAtoms()),
