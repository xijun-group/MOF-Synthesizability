+            raise ValueError("invalid_smiles_syntax")
+        if any(a.GetSymbol() not in ALLOWED_ELEMENTS for a in mol.GetAtoms()):
+            raise ValueError("unsupported_element_or_attachment_dummy")
+        if len(Chem.GetMolFrags(mol)) != 1:
