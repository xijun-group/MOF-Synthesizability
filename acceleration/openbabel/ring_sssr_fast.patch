 using namespace std;
 
+namespace
+{
+  // Ring identity as used by OBBitVec operator==: the set of on bits, independent of word count.
+  struct RingKeyHash
+  {
+    size_t operator()(const std::vector<int> &key) const
+    {
+      size_t h = key.size();
+      for (size_t i = 0; i < key.size(); ++i)
+        h = h * 1000003u ^ static_cast<size_t>(key[i]);
+      return h;
+    }
+  };
+  typedef std::unordered_set<std::vector<int>, RingKeyHash> RingKeySet;
+
+  std::vector<int> RingKey(const OpenBabel::OBBitVec &bv)
+  {
+    std::vector<int> key;
+    for (int bit = bv.NextBit(-1); bit != -1; bit = bv.NextBit(bit))
+      key.push_back(bit);
+    return key;
+  }
+
+  // Keys of the rings already in an OBRingSearch, so SaveUniqueRing avoids a linear scan.
+  // Kept outside the class to leave the public OBRingSearch layout (and ABI) unchanged.
+  struct RingIndex
+  {
+    size_t indexed;
+    RingKeySet keys;
+    RingIndex() : indexed(0) {}
+  };
+  thread_local std::unordered_map<const void*, RingIndex> ring_indices;
+}
